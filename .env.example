# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GMGN API Configuration
GMGN_API_KEY="gmgn_a64e1d6f370b44c4431e582fd1106454"

# Telegram API credentials for listening to calls
TELEGRAM_API_ID="33801866"
TELEGRAM_API_HASH="6139880385749ef5b9aee207dc41f887"
TELEGRAM_PHONE="+242068658897"
TELEGRAM_CHANNEL="pumpdotfunalert"
# Optional: GramJS string session to connect without SMS code on container startup
TELEGRAM_SESSION_STRING=""
# Optional: Comma-separated list of initial Telegram channels to monitor
TELEGRAM_CHANNELS="pumpdotfunalert,solana_tracker,dexscreener"

# Solana Network & Wallet Configuration
# Optional: Custom Solana RPC (Helius, QuickNode, Triton, or public RPC)
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Optional: Solana Private Key (Base58 string from Phantom/Solflare or JSON byte array)
# If provided, the bot imports this wallet automatically on launch for live mode
SOLANA_PRIVATE_KEY=""

